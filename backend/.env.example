LITELLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434

# --- NVIDIA NIM (Meta Llama 3.3 70B Instruct — free endpoint) ---
# To switch to NVIDIA NIM, comment out the lines above and uncomment these:
# LITELLM_MODEL=nvidia_nim/meta/llama-3.3-70b-instruct
# NVIDIA_NIM_API_KEY=nvapi-your-key-here

MAX_UPLOAD_MB=50
SESSION_TTL_HOURS=24
CORS_ORIGIN=http://localhost:5173
# LOG_DIR=~/.aegis/data/logs

# Firebase Admin SDK (paste service account JSON as single line, or base64-encode it)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=uploads
